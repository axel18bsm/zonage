{ ============================================================
  TYPES
  ============================================================ }
type
  TViewport = record
    OffX, OffY, Zoom : Single;
  end;

{ ============================================================
  VARIABLES GLOBALES
  ============================================================ }
var
  VP                     : TViewport;
  MapTex                 : TTexture2D;
  WinW, WinH             : Integer;
  HoveredIdx             : Integer;
  SelectedIdx            : Integer;
  HasSelection           : Boolean;
  IsDragging             : Boolean;
  DragStartX, DragStartY : Single;
  DragOffX,   DragOffY   : Single;
  ZoneStart              : array[0..ZONE_COUNT-1] of Integer;
  { variables boucle principale }
  Wheel                  : Single;
  MapX, MapY             : Single;
  Mx0, My0               : Single;
  Src                    : TRectangle;
  Dest                   : TRectangle;
  Zi, Pi2                : Integer;
  Cx2, Cy2               : Single;
  Sx3, Sy3               : Single;
  Lbl                    : string;

{ ============================================================
  INITIALISATION DES OFFSETS DE ZONES
  ============================================================ }
procedure InitZoneStarts;
var
  i, acc : Integer;
begin
  acc := 0;
  for i := 0 to ZONE_COUNT-1 do
  begin
    ZoneStart[i] := acc;
    Inc(acc, ZONE_PT_COUNT[i]);
  end;
end;

{ ============================================================
  VIEWPORT
  ============================================================ }
procedure ResetViewport;
var
  scaleX, scaleY, s : Single;
begin
  scaleX := WinW / IMG_W;
  scaleY := WinH / IMG_H;
  if scaleX < scaleY then s := scaleX
  else s := scaleY;
  VP.Zoom := s;
  VP.OffX := (WinW - IMG_W * s) * 0.5;
  VP.OffY := (WinH - IMG_H * s) * 0.5;
end;

{ ============================================================
  CONVERSIONS COORDONNEES
  ============================================================ }
procedure MapToScreen(mx, my : Single; out sx, sy : Single);
begin
  sx := mx * VP.Zoom + VP.OffX;
  sy := my * VP.Zoom + VP.OffY;
end;

procedure ScreenToMap(sx, sy : Single; out mx, my : Single);
begin
  mx := (sx - VP.OffX) / VP.Zoom;
  my := (sy - VP.OffY) / VP.Zoom;
end;

{ ============================================================
  POINT IN POLYGON  (ray-casting)
  ============================================================ }
function PointInPolygon(px, py : Single; startIdx, count : Integer) : Boolean;
var
  i, j           : Integer;
  xi, yi, xj, yj : Single;
  inside         : Boolean;
begin
  inside := False;
  j := startIdx + count - 1;
  for i := startIdx to startIdx + count - 1 do
  begin
    xi := PIX_X[i];
    yi := PIX_Y[i];
    xj := PIX_X[j];
    yj := PIX_Y[j];
    if ((yi > py) <> (yj > py)) and
       (px < (xj - xi) * (py - yi) / (yj - yi) + xi) then
      inside := not inside;
    j := i;
  end;
  Result := inside;
end;

function FindZoneAt(mx, my : Single) : Integer;
var
  i : Integer;
begin
  Result := -1;
  for i := ZONE_COUNT-1 downto 0 do
    if PointInPolygon(mx, my, ZoneStart[i], ZONE_PT_COUNT[i]) then
    begin
      Result := i;
      Exit;
    end;
end;

{ ============================================================
  SIGNE DE L'AIRE  (> 0 = CW en coords Y-down)
  ============================================================ }
function PolygonAreaSign(startIdx, count : Integer) : Double;
var
  i, j : Integer;
begin
  Result := 0;
  j := startIdx + count - 1;
  for i := startIdx to startIdx + count - 1 do
  begin
    Result := Result +
      (PIX_X[j] + PIX_X[i]) * Double(PIX_Y[j] - PIX_Y[i]);
    j := i;
  end;
end;

{ ============================================================
  DESSIN D'UN POLYGONE (tessellation centroide + winding auto)
  ============================================================ }
procedure DrawZonePoly(zoneIdx, startIdx : Integer;
                       fillCol, borderCol : TColorB);
var
  i          : Integer;
  n          : Integer;
  cx, cy     : Double;
  scx, scy   : Single;
  sx1, sy1   : Single;
  sx2, sy2   : Single;
  vc, va, vb : TVector2;
  cw         : Boolean;
begin
  n := ZONE_PT_COUNT[zoneIdx];

  cx := 0;
  cy := 0;
  for i := startIdx to startIdx + n - 1 do
  begin
    cx := cx + PIX_X[i];
    cy := cy + PIX_Y[i];
  end;
  cx := cx / n;
  cy := cy / n;

  MapToScreen(cx, cy, scx, scy);
  vc := Vector2Create(scx, scy);
  cw := PolygonAreaSign(startIdx, n) > 0;

  { Triangles centroide -> chaque arete }
  for i := startIdx to startIdx + n - 2 do
  begin
    MapToScreen(PIX_X[i],   PIX_Y[i],   sx1, sy1);
    MapToScreen(PIX_X[i+1], PIX_Y[i+1], sx2, sy2);
    va := Vector2Create(sx1, sy1);
    vb := Vector2Create(sx2, sy2);
    if cw then DrawTriangle(vc, vb, va, fillCol)
    else       DrawTriangle(vc, va, vb, fillCol);
  end;
  { Fermeture }
  MapToScreen(PIX_X[startIdx + n - 1], PIX_Y[startIdx + n - 1], sx1, sy1);
  MapToScreen(PIX_X[startIdx],         PIX_Y[startIdx],         sx2, sy2);
  va := Vector2Create(sx1, sy1);
  vb := Vector2Create(sx2, sy2);
  if cw then DrawTriangle(vc, vb, va, fillCol)
  else       DrawTriangle(vc, va, vb, fillCol);

  { Contour }
  for i := startIdx to startIdx + n - 2 do
  begin
    MapToScreen(PIX_X[i],   PIX_Y[i],   sx1, sy1);
    MapToScreen(PIX_X[i+1], PIX_Y[i+1], sx2, sy2);
    DrawLineEx(Vector2Create(sx1, sy1),
               Vector2Create(sx2, sy2), 2.0, borderCol);
  end;
  MapToScreen(PIX_X[startIdx + n - 1], PIX_Y[startIdx + n - 1], sx1, sy1);
  MapToScreen(PIX_X[startIdx],         PIX_Y[startIdx],         sx2, sy2);
  DrawLineEx(Vector2Create(sx1, sy1),
             Vector2Create(sx2, sy2), 2.0, borderCol);
end;

{ ============================================================
  COULEURS SELON ETAT
  ============================================================ }
function GetFillColor(idx : Integer) : TColorB;
begin
  if HasSelection and (idx = SelectedIdx) then
    Result := ColorAlpha(YELLOW, 0.45)
  else if idx = HoveredIdx then
    Result := ColorAlpha(WHITE, 0.30)
  else
    Result := ColorAlpha(SKYBLUE, 0.18);
end;

function GetBorderColor(idx : Integer) : TColorB;
begin
  if HasSelection and (idx = SelectedIdx) then
    Result := ORANGE
  else if idx = HoveredIdx then
    Result := WHITE
  else
    Result := ColorAlpha(WHITE, 0.55);
end;

{ ============================================================
  HUD
  ============================================================ }
procedure DrawHUD;
var
  s : string;
begin
  DrawRectangle(0, 0, WinW, 28, ColorAlpha(BLACK, 0.65));
  DrawText(
    'Hongrie 1526  |  Clic G=select  Clic D+drag=pan  Molette=zoom  R=reset  Echap=quitter',
    8, 7, 12, RAYWHITE);

  DrawRectangle(0, WinH - 28, WinW, 28, ColorAlpha(BLACK, 0.65));
  if HoveredIdx >= 0 then
    s := Format('Zone : %d   (%d sommets)',
                [ZONE_IDS[HoveredIdx], ZONE_PT_COUNT[HoveredIdx]])
  else
    s := 'Aucune zone sous le curseur';
  DrawText(PChar(s), 8, WinH - 20, 12, LIGHTGRAY);

  if HasSelection then
  begin
    s := Format('Selectionnee : Zone %d', [ZONE_IDS[SelectedIdx]]);
    DrawText(PChar(s), WinW - 220, WinH - 20, 12, YELLOW);
  end;
end;

{ ============================================================
  PROGRAMME PRINCIPAL
  ============================================================ }
begin
  InitZoneStarts;

  SetConfigFlags(FLAG_WINDOW_RESIZABLE);
  InitWindow(SCREEN_W, SCREEN_H, 'Detecteur de zones - Hongrie 1526');
  SetTargetFPS(60);

  MapTex := LoadTexture('hongrie2vrai.png');

  WinW := SCREEN_W;
  WinH := SCREEN_H;
  ResetViewport;

  HoveredIdx   := -1;
  SelectedIdx  := -1;
  HasSelection := False;
  IsDragging   := False;

  while not WindowShouldClose do
  begin
    WinW := GetScreenWidth;
    WinH := GetScreenHeight;

    { --- Zoom molette centre sur le curseur --- }
    Wheel := GetMouseWheelMove;
    if Wheel <> 0 then
    begin
      ScreenToMap(GetMouseX, GetMouseY, Mx0, My0);
      VP.Zoom := VP.Zoom * Power(1.12, Wheel);
      if VP.Zoom < 0.05 then VP.Zoom := 0.05;
      if VP.Zoom > 20.0  then VP.Zoom := 20.0;
      VP.OffX := GetMouseX - Mx0 * VP.Zoom;
      VP.OffY := GetMouseY - My0 * VP.Zoom;
    end;

    { --- Pan clic droit + drag --- }
    if IsMouseButtonPressed(MOUSE_BUTTON_RIGHT) then
    begin
      IsDragging := True;
      DragStartX := GetMouseX;
      DragStartY := GetMouseY;
      DragOffX   := VP.OffX;
      DragOffY   := VP.OffY;
    end;
    if IsMouseButtonReleased(MOUSE_BUTTON_RIGHT) then
      IsDragging := False;
    if IsDragging then
    begin
      VP.OffX := DragOffX + (GetMouseX - DragStartX);
      VP.OffY := DragOffY + (GetMouseY - DragStartY);
    end;

    { --- Reset vue --- }
    if IsKeyPressed(KEY_R) then
      ResetViewport;

    { --- Detection zone sous curseur --- }
    ScreenToMap(GetMouseX, GetMouseY, MapX, MapY);
    HoveredIdx := FindZoneAt(MapX, MapY);

    { --- Selection clic gauche --- }
    if IsMouseButtonPressed(MOUSE_BUTTON_LEFT) then
    begin
      if HoveredIdx >= 0 then
      begin
        SelectedIdx  := HoveredIdx;
        HasSelection := True;
      end
      else
      begin
        HasSelection := False;
        SelectedIdx  := -1;
      end;
    end;

    { ======================================================
      RENDU
      ====================================================== }
    BeginDrawing;
      ClearBackground(DARKGRAY);

      { Carte fond }
      Src.x      := 0;
      Src.y      := 0;
      Src.width  := IMG_W;
      Src.height := IMG_H;
      Dest.x      := VP.OffX;
      Dest.y      := VP.OffY;
      Dest.width  := IMG_W * VP.Zoom;
      Dest.height := IMG_H * VP.Zoom;
      DrawTexturePro(MapTex, Src, Dest, Vector2Create(0, 0), 0, WHITE);

      { Zones }
      for Zi := 0 to ZONE_COUNT-1 do
        DrawZonePoly(Zi, ZoneStart[Zi],
                     GetFillColor(Zi), GetBorderColor(Zi));

      { Etiquettes }
      for Zi := 0 to ZONE_COUNT-1 do
      begin
        Cx2 := 0;
        Cy2 := 0;
        for Pi2 := ZoneStart[Zi] to ZoneStart[Zi] + ZONE_PT_COUNT[Zi] - 1 do
        begin
          Cx2 := Cx2 + PIX_X[Pi2];
          Cy2 := Cy2 + PIX_Y[Pi2];
        end;
        Cx2 := Cx2 / ZONE_PT_COUNT[Zi];
        Cy2 := Cy2 / ZONE_PT_COUNT[Zi];
        MapToScreen(Cx2, Cy2, Sx3, Sy3);
        Lbl := IntToStr(ZONE_IDS[Zi]);
        DrawText(PChar(Lbl), Round(Sx3) - 9, Round(Sy3) - 9, 14, BLACK);
        DrawText(PChar(Lbl), Round(Sx3) - 8, Round(Sy3) - 8, 14, RAYWHITE);
      end;

      DrawHUD;
    EndDrawing;
  end;

  UnloadTexture(MapTex);
  CloseWindow;
end.
